# Bind to loopback until a reverse proxy and authentication layer are configured.
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=18080

# Keep this aligned with the version validated in CI and Containerfile.
CODEX_VERSION=0.147.0
IMAGE_TAG=local

WORKSPACE_ROOT=./runtime/workspaces
CODEX_HOME_HOST=./runtime/codex-home

# Set to :Z on SELinux-enforcing Red Hat-family hosts when Docker bind mounts need relabeling.
VOLUME_SUFFIX=

GATEWAY_CODEX_APPROVAL_POLICY=never
GATEWAY_CODEX_SANDBOX=workspace-write
GATEWAY_CODEX_MODEL=
GATEWAY_CODEX_TURN_TIMEOUT=10m
